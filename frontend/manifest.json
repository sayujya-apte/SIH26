{
  "manifest_version": 3,
  "name": "Chatbot Capture",
  "version": "1.0",
  "description": "A chatbot sidebar that captures input and the screen.",
  "permissions": ["tabs", "storage", "scripting", "downloads", "offscreen"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open Privacy Assistant"
  },
  "background": {
    "service_worker": "background.js"
  }
}
