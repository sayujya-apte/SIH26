{
  "manifest_version": 3,
  "name": "Chatbot Capture",
  "version": "1.0",
  "description": "A chatbot sidebar that captures input and the screen.",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": ["<all_urls>", "http://localhost:3000/*"], 
  "action": {
    "default_title": "Toggle Chatbot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["style.css"],
      "js": ["content.js"]
    }
  ]
}